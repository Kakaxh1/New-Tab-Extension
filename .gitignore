# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini
*.lnk

# Editor & IDE Directories
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~

# Extension Packages, Keys & Secrets
*.crx
*.pem
*.key
*.cert
*.pfx
*.token
credentials.json

# Build Outputs & Packaging
dist/
build/
*.zip

# Node & Package Managers
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
pnpm-lock.yaml
yarn.lock

# Temporary Testing & Scratch Artifacts
scratch/
test_shot.png
*.tmp
*.bak
*.log

# Local Environments, Cache & Private Data
.env
.env.local
.env.*.local
*.local
*lan-notes*
*lan_notes*
*.cache
